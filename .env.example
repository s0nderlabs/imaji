# Public base URL of this server (used in kit URLs the Mind reads back)
IMAJI_BASE_URL=https://imaji.s0nderlabs.xyz
# Read id whose newest kit the front door shows off. Unset, the front door
# falls back to imaji's own v0.2.0 kit, committed under public/showcase.
IMAJI_SHOWCASE_READID=
# Storage root for tokens and kits (gitignored)
IMAJI_DATA_DIR=./data
# Renderer binaries
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# Video engine. The film, the vertical cut and the launch video render at
# deviceScaleFactor x fps, sharded across worker processes.
# scale 2 turns the 1920x1080 stage into 3840x2160 and the 1080x1920 vertical
# stage into 2160x3840. Shards default to the core count minus two, capped at 8.
IMAJI_RENDER_SCALE=2
IMAJI_RENDER_FPS=60
IMAJI_RENDER_SHARDS=
# FILM_FPS is the old name for IMAJI_RENDER_FPS and is still read as a fallback.
